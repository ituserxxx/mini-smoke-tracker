.time-card {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}
.time-val {
  font-size: 64rpx;
  font-weight: 800;
  color: #2DD4FF;
  margin: 8rpx 0;
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", ui-monospace, monospace;
  text-shadow: 0 0 20rpx rgba(45, 212, 255, 0.5);
}

.card { margin-bottom: 24rpx; }

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.chip {
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(120, 160, 220, 0.08);
  border: 1rpx solid rgba(120, 160, 220, 0.18);
  color: #A9BBE0;
  font-size: 26rpx;
  transition: all .15s;
}
.chip-on {
  background: linear-gradient(135deg, rgba(45, 212, 255, 0.25), rgba(61, 245, 176, 0.18));
  color: #EAF7FF;
  border: 1rpx solid rgba(45, 212, 255, 0.6);
  box-shadow: 0 0 18rpx rgba(45, 212, 255, 0.35);
}

.input {
  background: rgba(120, 160, 220, 0.06);
  border: 1rpx solid rgba(120, 160, 220, 0.18);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #DCE7FF;
}
.textarea {
  background: rgba(120, 160, 220, 0.06);
  border: 1rpx solid rgba(120, 160, 220, 0.18);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #DCE7FF;
  width: 100%;
  box-sizing: border-box;
  height: 180rpx;
}

.save-btn {
  margin: 16rpx 0 12rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
}
.save-hover { opacity: 0.9; }

.tip {
  text-align: center;
  font-size: 22rpx;
  margin-top: 8rpx;
}
