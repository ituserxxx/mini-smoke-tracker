.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.greeting {
  font-size: 36rpx; font-weight: 600;
  color: #EAF2FF;
  text-shadow: 0 0 16rpx rgba(45, 212, 255, 0.25);
}
.date { font-size: 24rpx; margin-top: 6rpx; }
.header-badge {
  width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center;
  background: rgba(45, 212, 255, 0.08);
  border: 1rpx solid rgba(45, 212, 255, 0.4);
  border-radius: 50%;
  box-shadow: 0 0 18rpx rgba(45, 212, 255, 0.25) inset, 0 0 14rpx rgba(45, 212, 255, 0.2);
  font-size: 36rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 36rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(160deg, rgba(28, 54, 92, 0.5), rgba(10, 18, 36, 0.6));
}
.hero-title { font-size: 32rpx; font-weight: 600; color: #EAF2FF; }
.hero-sub { font-size: 24rpx; margin-top: 8rpx; }

.fab {
  margin: 40rpx 0 8rpx;
  width: 210rpx; height: 210rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 35%, #5FE3FF, #1FA8E0 70%);
  box-shadow: 0 0 0 6rpx rgba(45, 212, 255, 0.12),
              0 18rpx 44rpx rgba(31, 168, 224, 0.5),
              0 0 50rpx rgba(45, 212, 255, 0.45);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #04121E;
  animation: fabPulse 2.6s ease-in-out infinite;
}
@keyframes fabPulse {
  0%, 100% {
    box-shadow: 0 0 0 6rpx rgba(45, 212, 255, 0.12),
                0 18rpx 44rpx rgba(31, 168, 224, 0.5),
                0 0 40rpx rgba(45, 212, 255, 0.35);
  }
  50% {
    box-shadow: 0 0 0 14rpx rgba(45, 212, 255, 0.04),
                0 18rpx 44rpx rgba(31, 168, 224, 0.5),
                0 0 64rpx rgba(45, 212, 255, 0.6);
  }
}
.fab-hover { transform: scale(0.94); }
.fab-inner {
  font-size: 80rpx; font-weight: 800; line-height: 1;
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", ui-monospace, monospace;
  text-shadow: 0 0 18rpx rgba(255, 255, 255, 0.4);
}
.fab-label { font-size: 24rpx; margin-top: 8rpx; font-weight: 600; }
.hero-link { margin-top: 24rpx; font-size: 24rpx; color: #2DD4FF; }

.stats-row { display: flex; justify-content: space-between; margin-bottom: 24rpx; }
.stat {
  flex: 1; margin: 0 8rpx;
  display: flex; flex-direction: column; align-items: center;
}
.stat:first-child { margin-left: 0; }
.stat:last-child { margin-right: 0; }
.stat-num {
  font-size: 52rpx; font-weight: 800; color: #EAF2FF;
  font-family: "Bahnschrift", "DIN Alternate", "Roboto Mono", ui-monospace, monospace;
  text-shadow: 0 0 16rpx rgba(61, 245, 176, 0.35);
}
.stat-label { font-size: 22rpx; margin-top: 6rpx; }

.trend-card { margin-bottom: 24rpx; }
.link { color: #2DD4FF; }
.bars {
  display: flex; justify-content: space-between; align-items: flex-end;
  height: 220rpx; padding-top: 20rpx;
}
.bar-col {
  display: flex; flex-direction: column; align-items: center;
  flex: 1; height: 100%; justify-content: flex-end;
}
.bar-track {
  width: 36rpx; height: 160rpx;
  background: rgba(120, 160, 220, 0.08);
  border: 1rpx solid rgba(120, 160, 220, 0.15);
  border-radius: 18rpx;
  display: flex; align-items: flex-end; overflow: hidden;
}
.bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #5FE3FF, #1FA8E0);
  border-radius: 18rpx;
  box-shadow: 0 0 16rpx rgba(45, 212, 255, 0.6);
}
.bar-label { font-size: 20rpx; margin-top: 12rpx; }
