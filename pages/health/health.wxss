/* 健康统计页：科幻 HUD 风格，按 iPhone 17 Pro Max（440pt 宽）排版 */
.page {
  padding: 40rpx 32rpx calc(env(safe-area-inset-bottom) + 48rpx);
  box-sizing: border-box;
}

/* 核心换算 */
.hero {
  text-align: center;
  padding: 44rpx 36rpx 36rpx;
  margin-bottom: 12rpx;
}
.hero-label {
  font-size: 24rpx;
  color: #8FA6D6;
  letter-spacing: 4rpx;
}
.hero-num {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #EAF2FF;
  text-shadow: 0 0 28rpx rgba(45, 212, 255, 0.55);
  margin: 10rpx 0 6rpx;
}
.hero-num .unit {
  font-size: 30rpx;
  margin-left: 8rpx;
  color: #7C8DB5;
  text-shadow: none;
}
.hero-life {
  font-size: 28rpx;
  color: #C7D6F5;
  margin-top: 8rpx;
}
.life-num {
  color: #FF7A93;
  font-weight: 700;
  font-size: 34rpx;
  text-shadow: 0 0 20rpx rgba(255, 122, 147, 0.5);
}
.hero-range {
  font-size: 22rpx;
  color: #7C8DB5;
  margin-top: 10rpx;
}
.hero-free {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(120, 160, 220, 0.18);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.free-k { font-size: 22rpx; color: #8FA6D6; }
.free-v {
  font-size: 40rpx;
  font-weight: 700;
  color: #3DF5B0;
  text-shadow: 0 0 20rpx rgba(61, 245, 176, 0.5);
}

/* 每支烟的代价 */
.cost-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 12rpx;
}
.cost-item {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: linear-gradient(160deg, rgba(28, 44, 74, 0.55), rgba(11, 18, 34, 0.65));
  border: 1rpx solid rgba(45, 212, 255, 0.22);
  border-radius: 20rpx;
  padding: 26rpx 22rpx;
  position: relative;
}
.cost-v {
  font-size: 40rpx;
  font-weight: 700;
  text-shadow: 0 0 18rpx currentColor;
}
.cost-l { font-size: 26rpx; color: #EAF2FF; margin-top: 6rpx; font-weight: 600; }
.cost-d { font-size: 20rpx; color: #7C8DB5; margin-top: 8rpx; line-height: 1.4; }

/* 疾病风险 */
.risk-card { padding: 8rpx 30rpx; }
.risk-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(120, 160, 220, 0.12);
}
.risk-item:last-child { border-bottom: none; }
.risk-name { flex: 1; font-size: 27rpx; color: #C7D6F5; }
.risk-level {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFC24B;
  text-shadow: 0 0 16rpx rgba(255, 194, 75, 0.4);
  margin-right: 16rpx;
}
.risk-src {
  font-size: 19rpx;
  color: #6E80A8;
  background: rgba(120, 160, 220, 0.10);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

/* 恢复时间轴 */
.tl-card { padding: 30rpx 30rpx 10rpx; }
.tl-head {
  font-size: 24rpx;
  color: #2DD4FF;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
  text-shadow: 0 0 14rpx rgba(45, 212, 255, 0.5);
}
.tl {
  display: flex;
  align-items: flex-start;
  position: relative;
  padding-bottom: 26rpx;
}
.tl:not(:last-child)::after {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 26rpx;
  bottom: 0;
  width: 2rpx;
  background: rgba(120, 160, 220, 0.20);
}
.tl-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(120, 160, 220, 0.45);
  background: #0B1222;
  flex-shrink: 0;
  margin-top: 6rpx;
}
.tl-dot.on {
  border-color: #3DF5B0;
  background: #3DF5B0;
  box-shadow: 0 0 18rpx rgba(61, 245, 176, 0.7);
}
.tl-body { flex: 1; margin-left: 20rpx; }
.tl-time { font-size: 26rpx; font-weight: 700; color: #8FA6D6; }
.tl-time.on { color: #3DF5B0; text-shadow: 0 0 14rpx rgba(61, 245, 176, 0.45); }
.tl-desc { font-size: 24rpx; color: #7C8DB5; margin-top: 4rpx; line-height: 1.45; }
.tl-flag {
  color: #3DF5B0;
  font-size: 26rpx;
  margin-left: 12rpx;
  margin-top: 4rpx;
}

/* 数据来源 */
.src-card { padding: 28rpx 30rpx; }
.src-item { font-size: 22rpx; color: #8FA6D6; line-height: 1.7; }
.src-note {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(120, 160, 220, 0.14);
  font-size: 21rpx;
  color: #6E80A8;
  line-height: 1.6;
}
