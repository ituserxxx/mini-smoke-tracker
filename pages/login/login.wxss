.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  box-sizing: border-box;
  background:
    radial-gradient(70% 50% at 50% 30%, rgba(45, 212, 255, 0.14), transparent 60%),
    radial-gradient(60% 40% at 80% 80%, rgba(181, 123, 255, 0.12), transparent 60%),
    #060B16;
}
.logo {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 0 20rpx rgba(45, 212, 255, 0.6));
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #EAF2FF;
  text-shadow: 0 0 24rpx rgba(45, 212, 255, 0.4);
}
.subtitle {
  font-size: 26rpx;
  color: #7C8DB5;
  text-align: center;
  margin: 16rpx 0 64rpx;
  line-height: 1.6;
}
.wx-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
}
.err {
  color: #FF8198;
  font-size: 24rpx;
  margin-top: 24rpx;
  text-align: center;
}
.tip {
  font-size: 22rpx;
  color: #7C8DB5;
  text-align: center;
  margin-top: 48rpx;
  line-height: 1.6;
}
