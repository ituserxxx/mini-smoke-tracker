/* 分享页：按 iPhone 17 Pro Max（440×956 pt）竖向布局 */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: calc(env(safe-area-inset-top) + 44rpx) 40rpx calc(env(safe-area-inset-bottom) + 36rpx);
}

/* 头部 */
.head { text-align: center; }
.kicker {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #2DD4FF;
  text-shadow: 0 0 12rpx rgba(45, 212, 255, 0.6);
  margin-bottom: 14rpx;
}
.h-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #EAF2FF;
}
.h-sub {
  font-size: 24rpx;
  color: #7C8DB5;
  margin-top: 10rpx;
}

/* 海报舞台：占满中间剩余空间并居中 */
.poster-stage {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
}
.poster {
  border-radius: 30rpx;
  border: 1rpx solid rgba(45, 212, 255, 0.35);
  box-shadow:
    0 0 40rpx rgba(45, 212, 255, 0.22),
    0 18rpx 50rpx rgba(0, 0, 0, 0.55);
}
.poster-placeholder {
  position: absolute;
  color: #7C8DB5;
  font-size: 26rpx;
}

/* 时间段筛选 */
.ranges {
  display: flex;
  gap: 14rpx;
  margin: 6rpx 0 2rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
  -webkit-overflow-scrolling: touch;
}
.range-pill {
  flex: 0 0 auto;
  padding: 12rpx 22rpx;
  font-size: 22rpx;
  color: #8FA6D6;
  background: rgba(20, 32, 56, 0.6);
  border: 1rpx solid rgba(95, 227, 255, 0.25);
  border-radius: 999rpx;
  white-space: nowrap;
}
.range-pill.active {
  color: #061018;
  background: linear-gradient(90deg, #5FE3FF, #3DF5B0);
  border-color: transparent;
  font-weight: 700;
  box-shadow: 0 0 18rpx rgba(95, 227, 255, 0.5);
}

/* 操作区 */
.actions {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}
.btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 30rpx;
  box-sizing: border-box;
}
.btn-disabled { opacity: 0.55; }
.btn-hover { transform: translateY(2rpx); filter: brightness(1.05); }

/* 去掉 button 默认边框/圆角 */
.btn-ghost { margin: 0; padding: 0; }
.btn-ghost::after { border: none; }

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #7C8DB5;
  margin-top: 22rpx;
}
