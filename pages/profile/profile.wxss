.card { margin-bottom: 24rpx; }

.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid rgba(120, 160, 220, 0.12);
}
.field:last-of-type { border-bottom: none; }
.field-label { font-size: 28rpx; color: #DCE7FF; }
.field-input {
  text-align: right;
  font-size: 28rpx;
  color: #3DF5B0;
  width: 200rpx;
}
.field-value { font-size: 28rpx; color: #3DF5B0; }

.save-btn {
  margin: 24rpx 0 12rpx;
  height: 88rpx; line-height: 88rpx;
  text-align: center; font-size: 30rpx;
}
.save-hover { opacity: 0.9; }
.tip { font-size: 22rpx; text-align: center; margin-top: 8rpx; }

.danger-btn {
  margin-top: 8rpx;
  height: 88rpx; line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(255, 92, 122, 0.1);
  border: 1rpx solid rgba(255, 92, 122, 0.45);
  color: #FF8198;
  font-size: 30rpx;
  box-shadow: 0 0 18rpx rgba(255, 92, 122, 0.15) inset;
}

.about {
  text-align: center;
  font-size: 22rpx;
  margin: 16rpx 0 40rpx;
}
